{
  "name": "FlashCart · Unified Mall Checkout",
  "short_name": "FlashCart",
  "description": "Scan across every store in the mall, pay once, walk out.",
  "id": "/",
  "start_url": "/#/shop",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#fafafa",
  "theme_color": "#0066ff",
  "categories": ["shopping", "finance"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Scan a barcode", "url": "/#/shop/scan", "description": "Open the scanner" },
    { "name": "My bag", "url": "/#/shop/bag" },
    { "name": "Cash desk", "url": "/#/pos" }
  ]
}
