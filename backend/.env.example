# ─── Server ──────────────────────────────────────────────
PORT=5005
NODE_ENV=development
# Comma-separated list of allowed origins. Leave empty to allow all (dev only).
CORS_ORIGIN=

# ─── Database (SQLite) ───────────────────────────────────
# File is created on first run. Relative paths resolve from backend/.
DATABASE_PATH=data/flashcart.db

# ─── Sign-in ─────────────────────────────────────────────
# Signs login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
CUSTOMER_TOKEN_TTL_HOURS=720
CASHIER_TOKEN_TTL_HOURS=12

# First cashier account — created only when the cashiers table is empty.
# Add more later with: npm run cashier:add -- --email you@mall.in --name "Your Name"
SEED_CASHIER_EMAIL=cashier@flashcart.in
SEED_CASHIER_PASSWORD=change-me-please
SEED_CASHIER_NAME=Desk Cashier

# ─── Razorpay ────────────────────────────────────────────
# Test keys: https://dashboard.razorpay.com/app/keys (switch to Test Mode).
# Leave BOTH empty to run the built-in simulated gateway (no account needed).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ─── Invoice details ─────────────────────────────────────
MALL_NAME=Phoenix Grand Mall
MALL_LEGAL_NAME=FlashCart Retail Services Pvt. Ltd.
MALL_GSTIN=29ABCDE1234F1Z5
MALL_ADDRESS=Whitefield Main Road, Bengaluru, Karnataka 560066

# ─── Limits ──────────────────────────────────────────────
SESSION_TTL_MINUTES=240
MAX_LINE_QUANTITY=25
